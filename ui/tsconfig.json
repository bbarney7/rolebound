{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "server",
    "shared",
    "scripts",
    "vite.config.ts",
    "../.pi/extensions/lib/targets.ts",
    "../scripts/workspace.d.mts",
    "../scripts/release-tools.d.mts"
  ]
}
