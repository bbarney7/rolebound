{
  "name": "pi-jobs",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "ui"
  ],
  "version": "0.1.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Root test/typecheck harness for the Rolebound (pi-jobs) workspace",
  "//": "No \"type\": \"module\" on purpose \u2014 the repo root holds CommonJS apply-*.js scripts, and pi loads .pi/extensions/*.ts through jiti, which does not need it. New ESM scripts use the .mjs extension.",
  "scripts": {
    "setup": "node scripts/pi-jobs.mjs setup",
    "build": "node scripts/pi-jobs.mjs build",
    "start": "node scripts/pi-jobs.mjs start",
    "dev": "node scripts/pi-jobs.mjs dev",
    "demo": "node scripts/pi-jobs.mjs demo",
    "doctor": "node scripts/pi-jobs.mjs doctor",
    "restore": "node scripts/pi-jobs.mjs restore",
    "backup": "node scripts/pi-jobs.mjs backup",
    "upgrade-smoke": "node scripts/upgrade-smoke.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "release:export": "node scripts/release-export.mjs",
    "runtime-smoke": "node scripts/runtime-smoke.mjs",
    "submission-smoke": "node scripts/submission-smoke.mjs",
    "server-smoke": "node scripts/server-smoke.mjs",
    "demo-smoke": "node scripts/demo-smoke.mjs",
    "fresh-user-smoke": "node scripts/fresh-user-smoke.mjs",
    "browser-test": "npm run build && npm run test:e2e --workspace ui",
    "workspace-test": "node --test scripts/workspace.test.mjs scripts/submission-docs.test.mjs scripts/fixtures/scripted-model.test.mjs ui/e2e/fixtures/ats-json/server.test.mjs scripts/doctor.test.mjs scripts/fresh-user-smoke.test.mjs scripts/ci-workflow.test.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lifecycle-test": "node --test scripts/process-lifecycle.test.mjs scripts/dependency-audit.test.mjs",
    "audit:deps": "node scripts/dependency-audit.mjs"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.37",
    "@types/proper-lockfile": "^4.1.4",
    "pi-cursor-sdk": "0.5.3",
    "proper-lockfile": "^4.1.2",
    "pdf2json": "3.2.2",
    "mammoth": "1.13.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@playwright/mcp": "0.0.80",
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.1.1",
    "playwright": "^1.61.0",
    "puppeteer-core": "^25.8.0",
    "tsx": "^4.23.1",
    "typebox": "1.3.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "concurrently": "10.0.5"
  },
  "overrides": {
    "jsdom": "29.1.1",
    "vite": "8.3.4",
    "concurrently": {
      "shell-quote": "1.11.0"
    }
  }
}
