{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {}
  },
  // lib/ is checked because it is plain TypeScript with no pi imports; ats-adapters.ts is
  // checked alongside the chat workspace tools and submission guard. Other top-level
  // .pi/extensions/*.ts stay out of scope.
  "include": [
    ".pi/extensions/lib/**/*.ts",
    ".pi/extensions/ats-adapters.ts",
    ".pi/extensions/workspace-tools.ts",
    ".pi/extensions/submission-guard.ts",
    ".pi/extensions/ats-adapters.offpath.test.ts",
    "vitest.config.mts",
    // lib/scoring.ts now reaches ui/server/providers/cursorModels.ts, which needs these declarations.
    "ui/server/pi-cursor-sdk-shims.d.ts"
  ]
}
